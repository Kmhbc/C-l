#include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define SIZE 5

struct FlightInfo{
	char flightNumber[20];
	float ticketCost;
};

struct Passenger {
	char passengerID[20];
	char passengerName[80];
	char destination[80];
	struct FlightInfo f;
};

void displayp(struct Passenger p[]){
	
	system("cls");
	
	printf("\n==== PASSENGER LIST ====\n");
	
	for (int i = 0; i<SIZE; i++){
		printf("\n\nPassenger #%d\n", i+1);
		printf("Passenger ID: %s\n", p[i].passengerID);
		printf("Passenger Name: %s", p[i].passengerName);
		printf("Destination: %s", p[i].destination);
		printf("Flight Number: %s\n", p[i].f.flightNumber);
		printf("Ticket Cost: %.2f", p[i].f.ticketCost);
	}
	
	printf("\n\nPress ENTER to continue...");
	getchar();
}

void inputp(struct Passenger p[]){
	
	system("cls");
	
	printf("Enter Passenger Data:\n");
	
	for (int i = 0; i<SIZE; i++){
		printf("\nPassenger #%d\n", i+1);
		printf("Enter Passenger ID (ex: P001): ");
		scanf(" %s", &p[i].passengerID);
		getchar();
		printf("Enter Passenger Name (First name, Last name): ");
		fgets(p[i].passengerName,sizeof(p[i].passengerName), stdin);
		printf("Enter Destination: ");
		fgets(p[i].destination,sizeof(p[i].destination), stdin);
		printf("Enter Flight Number (ex: 001): ");
		scanf(" %s", &p[i].f.flightNumber);
		printf("Enter Ticket Cost (ex: 4000): ");
		scanf("%f", &p[i].f.ticketCost);
	}
	
	printf("\n\nPress ENTER to continue...");
}

void summp(struct Passenger p[]){
	
	printf("\n==== FLIGHT SUMMARY ====\n");
	
	int sum = 0, highestindex = 0, highestcost = p[0].f.ticketCost;
	int lowestindex = 0, lowestcost = p[0].f.ticketCost;
	int currenthigh, currentlow;
	float ave = 0;
	
	for (int i = 0; i<SIZE; i++){
		sum += p[i].f.ticketCost;	
	}
	ave = sum/ SIZE;
	
	printf("\nTotal Ticket Cost: %d", sum);
	printf("\nAverage Ticket Cost: %.2f", ave);
	
	for (int i = 0; i<SIZE; i++){
		currenthigh = p[i].f.ticketCost;
		if(highestcost > currenthigh){
			highestcost = currenthigh;
			highestindex = i;
		}
	}
	printf("\n\nHighest Ticket Cost:\n");
	printf("Passenger ID: %s\n", p[highestindex].passengerID);
	printf("Passenger Name: %s", p[highestindex].passengerName);
	printf("Ticket Cost: %.2f", p[highestindex].f.ticketCost);
	
	for (int i = 0; i<SIZE; i++){
		currentlow = p[i].f.ticketCost;
		if(lowestcost < currentlow){
			lowestcost = currentlow;
			lowestindex = i;
		}
	}
	printf("\n\nLowest Ticket Cost:\n");
	printf("Passenger ID: %s\n", p[lowestindex].passengerID);
	printf("Passenger Name: %s", p[lowestindex].passengerName);
	printf("Ticket Cost: %.2f", p[lowestindex].f.ticketCost);
	
	printf("\n\nPress ENTER to continue...");
}

void savep(struct Passenger p[]){
	
	FILE *fp= fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\flights.txt", "w");
	
