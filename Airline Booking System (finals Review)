void readp(struct Passenger p[]){
	
	FILE *fp= fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\flights.txt", "r");
	
	char line[200];
	
	for(int i = 0; i<SIZE; i++){
		while(fgets(line, sizeof(line), fp) != NULL){
			printf(" %s", line);
		}
	}
	
	fclose(fp);
}

void searchp(struct Passenger p[]){
	
	system("cls");
	
	int found = 0;
	char searchID[20];
	
	printf("Enter Passenger ID to Search: ");
	scanf("%19s", searchID);
	
	
	for (int i = 0; i<SIZE; i++){
		if(strcmp(searchID,p[i].passengerID) == 0){
			printf("\n FOUND!\n");
			printf("Passenger ID: %s\n", p[i].passengerID);
			printf("Passenger Name: %s", p[i].passengerName);
			printf("Destination: %s", p[i].destination);
			printf("Flight Number: %s\n", p[i].f.flightNumber);
			printf("Ticket Cost: %.2f", p[i].f.ticketCost);
			
			found = 1;
			break;
		}
	}
	
	if (found ==0){
		printf("\n\nNO PASSENGER FOUND!\n");
	}	
	
	printf("\n\nPress ENTER to continue...");
	getchar();
}
