#include <stdio.h>


int main(){
    int age, IPA, choice;
    char gen, retry;
    int hour, min, sec, finsec;
    int a, b, c, d;
    
    do {
        printf("====MENU PROGRAM====\n\n");
        printf("1. Plato's Theory\n");
        printf("2. Seconds to Time\n");
        printf("3. Smiley\n");
        printf("4. Exit\n");
        
        printf("\nEnter your choice:");
        scanf("%d", &choice);
        switch (choice) {
            case 1:
            do {
                printf("\nplease enter your age:");
                scanf ("%d",&age);
                
                printf ("please enter your gender in character:");
                scanf ("\n%c",&gen);
                
                if (gen=='m'||gen=='M')
                {IPA=age/2+7;
                } else
                {IPA=(age-7)*2;
                }
                printf("Your ideal partners age is %d\n",IPA);
                
                printf("\nTry again? Y (repeat same program) / N (go back to main menu): ");
                scanf(" %c", &retry);
                
            } while (retry == 'Y' || retry == 'y');
                break;
            
			case 2:
            do { 
                printf ("\nEnter number of seconds: ");
				scanf ("%d", &sec);
	
				hour = sec/3600;
				min = (sec%3600)/60;
				finsec = (sec%3600)%60;
	
				printf ("\t\nhour:\t\t %d", hour);
				printf ("\t\nminute: \t %d", min);
				printf ("\t\nsecond: \t %d", finsec);
	
				printf ("\n\nThe time is %02d:%02d%:%02d", hour, min, finsec);
                
                printf("\nTry again? Y (repeat same program) / N (go back to main menu): ");
                scanf(" %c", &retry);

            } while (retry == 'Y' || retry == 'y');
                break;
                
			case 3:
            do {
                printf("\nEnter three numbers\n");
	            scanf("%d %d %d", &a, &b, &c);
	            
                d=((a + b + c) * 2 )+ 7;
                printf("\nTwice the sum of %d %d %d plus seven is %d :):):)", a,b,c,d);
                printf("\nTry again? Y (repeat same program) / N (go back to main menu): ");
                 scanf(" %c", &retry);

            } while (retry == 'Y' || retry == 'y');
            
            break;
            
			case 4:
        	printf("\nDo you really want to exit? Y (terminate) / N (back to menu): ");
            scanf(" %c", &retry);

            if (retry == 'Y' || retry == 'y') {
                printf("\nProgram terminated. Goodbye! And Thank you!!\n");
            
			return 0;
			
			} else
				break;
				
            default:
            printf("\nInvalid choice! Please try again.\n");
    	}	
    	
    } while (retry == 'N' || retry == 'n');
            
            return 0;
            
}
