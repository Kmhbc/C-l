#include <stdio.h>

int fibonacci(int n) {
    if (n == 0)  // base case
        return 0;
    if (n == 1)  // base case
        return 1; 
        
    return fibonacci(n - 1) + fibonacci(n - 2); //recursive case
}

int main() {
    int n;
    
	printf("FIBONACCI SEQUENCE\n\n");
    printf("Enter n: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Invalid input\n");
        return 0;
    }

    printf("Fibonacci: %d\n", fibonacci(n));

    return 0;
}
