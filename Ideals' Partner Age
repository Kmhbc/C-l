#include <stdio.h>

int main (){
	int age, IPA;
	char a;
	
	printf("Please enter your gender M (Male) and F (Female): ");
	scanf(" %c", &a);
	printf ("Enter your Age: ");
	scanf ("%d", &age);
	
	if ( a == 'm' || a == 'M' )
		IPA= a / 2 + 7;	
	else
		IPA = (age - 7) * 2;
			
	printf("Your ideal partner's age is: %d", IPA);
return 0;
}
