#include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define SIZE 5

struct Reservation{
	char seatNumber [20];
	float ticketPrice;
};

struct Movie{
	char movieID[20];
	char movieTitle[80];
	char genre[20];
	struct Reservation resmovData;
};

void inputmovData(struct Movie movData[]){
	
	printf("\n=== DATA INPUT ===\n");
	
	for(int i = 0; i<SIZE; i++){
		printf("\nEnter Movie ID (ex: M001): ");
		scanf(" %s", &movData[i].movieID);
		getchar();
		printf("Enter Movie Title: ");
		fgets(movData[i].movieTitle, sizeof(movData[i].movieTitle), stdin);
		printf("Enter Genre: ");
		scanf(" %s", &movData[i].genre);
		getchar();
		printf("Enter Seat Number (ex: E16): ");
		scanf(" %s", &movData[i].resmovData.seatNumber);
		printf("Enter Ticket Price: ");
		scanf("%f", &movData[i].resmovData.ticketPrice);
	}
}
void displaymovData(struct Movie movData[]){
	
	printf("\n\n=== MOVIE LIST ===\n");
	
	for(int i = 0; i<SIZE; i++){
		printf("\n\nMovie No. %d\n", i+1);
		printf("Movie ID: %s\n", movData[i].movieID);
		printf("Movie Title: %s", movData[i].movieTitle);
		printf("Genre: %s\n", movData[i].genre);
		printf("Seat Number: %s\n", movData[i].resmovData.seatNumber);
		printf("Ticket Price: %.2f", movData[i].resmovData.ticketPrice);
	}
}

void displayplusThree(struct Movie movData[]){
	
	for (int i = 0; i<SIZE; i++){
		if(movData[i].resmovData.ticketPrice > 300){
			printf("\nMovie ID: %s\n", movData[i].movieID);
			printf("Movie Title: %s", movData[i].movieTitle);
			printf("Ticket Price: %.2f", movData[i].resmovData.ticketPrice);
		}
	}
}

void savemovData(struct Movie movData[]){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\movies.txt", "w");
	
	if(fp == NULL){
		printf("File record does not exist!");
	}
	
	fprintf(fp,"\n\n=== MOVIE LIST ===\n");
	
	for(int i = 0; i<SIZE; i++){
		fprintf(fp,"\n\nMovie No. %d\n", i+1);
		fprintf(fp,"Movie ID: %s\n", movData[i].movieID);
		fprintf(fp,"Movie Title: %s", movData[i].movieTitle);
		fprintf(fp,"Genre: %s\n", movData[i].genre);
		fprintf(fp,"Seat Number: %s\n", movData[i].resmovData.seatNumber);
		fprintf(fp,"Ticket Price: %.2f", movData[i].resmovData.ticketPrice);
	}
	
	fclose(fp);
}

void readmovData(struct Movie movData[]){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\movies.txt", "r");
	
	if(fp == NULL){
		printf("\nFile record does not exist!");
	}
	
	char line[200];
	
	printf("\n=== FILE CONTENT ===\n");
	
	while(fgets(line, sizeof(line), fp) != NULL){
		printf("%s", line);
	}
	
	fclose(fp);
}

void searchmovData(struct Movie movData[]){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\movies.txt", "r");
	
	int found = 0;
	char searchID[20];
	
	printf("\nEnter Movie ID: ");
	scanf("%19s", searchID);
	
	for(int i = 0; i<SIZE; i++){
		if(strcmp(searchID, movData[i].movieID) == 0){
			printf("Movie Title: %s", movData[i].movieTitle);
			printf("Genre: %s\n", movData[i].genre);
			printf("Seat Number: %s\n", movData[i].resmovData.seatNumber);
			printf("Ticket Price: %.2f", movData[i].resmovData.ticketPrice);
			
			found =1;
			break;	
		}
	}
	
	if (found == 0){
		printf("\nNo matching Movie ID in the file.\n");
	}
	fclose(fp);
}

int main(){
	struct Movie movData[100];
	int choice;
	
	do{
		printf("\n\n=== MOVIE MENU ===\n");
		printf("1. Enter Data\n");
		printf("2. Display All from Array\n");
		printf("3. Display Movies with Ticket prices greater than 300\n");
		printf("4. Save data to file\n");
		printf("5. Display All data from file\n");
		printf("6. Search Data from file\n");
		printf("7. Exit\n");
		printf("Choice: ");
		scanf("%d", &choice);
		
		switch(choice){
			
			case 1:
				inputmovData(movData);
			break;
			
			case 2:	
				displaymovData(movData);
			break;
			
			case 3:	
				displayplusThree(movData);
			break;
			
			case 4:	
				savemovData(movData);
				printf("\nData Saved Successfully!\n");
			break;
						
			case 5:	
				readmovData(movData);
			break;
			
			case 6:	
				searchmovData(movData);
			break;
		}
	}while(choice != 7);
return 0;	
}
