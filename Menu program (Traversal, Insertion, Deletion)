#include<stdio.h>

int main(){

	int a[50], size, i, num, pos, choice, op, item;
	
	do{
		printf("\n\n======ARRAY OPERATIONS======\n\n");
		printf("Which Operation would you like to perform: \n1.Traversal\n2.Insertion\n3.Deletion");
		printf("\n\nChoice: ");
		scanf("%d", &op);
		
		printf("\nEnter the size of Array: ");
		scanf("%d", &size);
		
			if (size>50){
				printf("\nInvalid! Input size less than 50.");
			}
			else{
				printf("Enter Elements of Array: ");
				for (i=0; i<size; i++){
					scanf("%d", &a[i]);
				}
			switch(op){
			
				case 1:
				// Traversal
						printf("\nThe Elements of the Array are: ");
							for (i=0; i<size; i++){
								printf("%d ", a[i]);
							}	
				break;
				
				case 2:			
				// Insertion	
						printf("\n\nEnter Value to be inserted: "); 
						scanf("%d", &num);
						printf("\nWhere do you want to insert the value?\n");
						printf("\n1.Beginning\n2.End\n3.Somewhere in the middle ");
						printf("\n\nChoice:");
						scanf("%d", &choice);
						
						switch (choice){
						
							case 1: 
								for (i=size; i>=0; i--){
									a[i+1]=a[i];
								}
								a[0]=num;
								size++;
								printf ("\nUpdated Array with inserted value: ");
									for (i=0; i<size; i++){
											printf("%d ", a[i]);
											
										}
							break;
							case 2:
								a[size]=num;
								size++;
								printf ("\nUpdated Array with inserted value: ");
									for (i=0; i<size; i++){
											printf("%d ", a[i]);
										}
							break;	
							
							case 3: 
							printf("\n1.Adjust Array position(For Sorted Array).\n2.Put the value of the chosen position at the end (For Unsorted Array).");
							printf("\n\nChoice: ");
							scanf("%d", &choice);
							
							if (choice==1){
								printf("Enter position where value is stored: ");
								scanf("%d", &pos);
								if (pos<=0 || pos>size){
									printf("\nInvalid Position! Input position less than the size of Array.");
								}
								else{
									for (i=size; i>=pos-1; i--){
										a[i+1]=a[i];
									}
								a[pos-1]=num;
								size++;
								printf ("\nUpdated Array with inserted value: ");
								for (i=0; i<size; i++){
										printf("%d ", a[i]);
									}
								}
							}
							else{
								printf("Enter position where value is stored: ");
								scanf("%d", &pos);
								if (pos<=0 || pos>size){
									printf("\nInvalid Position! Input position less than the size of Array.");
								}
								else{
									a[size]=a[pos-1];
									a[pos-1]=num;
									size++;
									printf ("\nUpdated Array with inserted value: ");
										for (i=0; i<size; i++){
												printf("%d ", a[i]);
									}
								}	
							break;
							
						}
					}
					break;
					
				case 3:
					printf("\nIn which position do you want to delete?\n");
					printf("\n1.Beginning\n2.End\n3.Somewhere in the middle\n");
					printf("\nChoice:"); 
					scanf ("%d", &choice);
					
					switch(choice){
						
							case 1:
								for (i=0; i<size-1; i++){
									a[i]=a[i+1];
								}
								size--;
								item = a[size];
								printf("\nNumber Deleted: %d", item);
								printf("\nUpdated array with deleted value: ");
									for (i=0; i<size; i++){
										printf("%d ", a[i]);
									}
							break;
							
							case 2:
								size--;
								item = a[size];
								printf("\nNumber Deleted: %d", item);
								printf ("\nUpdated Array with deleted value: ");
									for (i=0; i<size; i++){
										printf("%d ", a[i]);
									}
							break;
							
							case 3:
							printf("\nEnter position of the value you want to delete: ");
							scanf("%d", &pos);
							
								item = a[pos-1];
							
							if (pos<=0 || pos>size){
								printf("\nInvalid Position! Input position less than the size of Array.");
							}
							else{	
								for (i=pos-1; i<size-1; i++){
									a[i]=a[i+1];
								}
								size--;
								printf("\nNumber Deleted: %d", item);
								printf ("\nUpdated Array with deleted value: ");
												for (i=0; i<size; i++){
														printf("%d ", a[i]);
							}
							break;
						}
				}
			}
		} 
	}while(1);
return 0;
}

