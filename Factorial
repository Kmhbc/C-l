#include <stdio.h>

int factorial(int n) {
    if (n == 0)   // base case
        return 1;

    return  n * factorial(n - 1);  // recursive case
}

int main() {
    int n; 
	
	printf("FACTORIAL CALCULATOR\n\n");
    printf("Enter a non-negative number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Invalid input\n");
        return 0;
    }

    printf("Factorial: %d\n", factorial(n));

    return 0;
}
