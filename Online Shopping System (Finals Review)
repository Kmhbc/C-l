#include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define SIZE 5

struct OrderInfo{
	char quantity[20];
	float totalAmount;
};

struct Customer{
	char customerID[20];
	char customerName[80];
	char productOrdered[80];
	struct OrderInfo r;
};

void displayc(struct Customer c[]){
	
	system("cls");
	
	printf("\n==== CUSTOMER LIST ====");
	for(int i  = 0; i<SIZE; i++){
		printf("\n\nCustomer #%d\n", i+1);
		printf("Customer ID: %s\n", c[i].customerID);
		printf("Customer Name: %s", c[i].customerName);
		printf("Product Ordered: %s", c[i].productOrdered);
		printf("Product Quantity: %s\n", c[i].r.quantity);
		printf("Total Amount: %.2f",c[i].r.totalAmount);
	}
	
	printf("\n\nPlease ENTER to continue...");
	
	getchar();
	
}

void inputc(struct Customer c[]){
	
	system("cls");
	
	for(int i  = 0; i<SIZE; i++){
		printf("\n\nCustomer #%d\n", i+1);
		printf("Enter Customer ID(ex: C001): ");
		scanf(" %s", &c[i].customerID);
		getchar();
		printf("Enter Customer Name(First name, Last name): ");
		fgets(c[i].customerName, sizeof(c[i].customerName), stdin);
		printf("Enter Product Ordered: ");
		fgets(c[i].productOrdered, sizeof(c[i].productOrdered), stdin);
		printf("Enter Product Quantity: ");
		scanf(" %s", &c[i].r.quantity);
		getchar();
		printf("Enter Total Amount: ");
		scanf("%f", &c[i].r.totalAmount);
	}
	
	printf("\n\nPlease ENTER to continue...");
}

void summc(struct Customer c[]){
	
	printf("\n\n==== SALES SUMMARY ====\n");
	
	int sum = 0, highesti= 0, highesto = c[0].r.totalAmount;
	int lowesti= 0, lowesto = c[0].r.totalAmount;
	int currentlow, currenthigh;
	float ave;
	
	for(int i  = 0; i<SIZE; i++){
		sum += c[i].r.totalAmount;
	}
	
	ave = sum/SIZE;
	
	printf("\n\nTotal Sales: %d\n", sum);
	printf("Average Order: %.2f\n\n", ave);
	
	for(int i  = 0; i<SIZE; i++){
		currenthigh = c[i].r.totalAmount;
		if(highesto < currenthigh){
			highesto = currenthigh;
			highesti = i;
		}
	}
	
	printf("Highest Order:\n");
	printf("Customer ID: %s\n", c[highesti].customerID);
	printf("Total Amount: %.2f",c[highesti].r.totalAmount);
	
	for(int i  = 0; i<SIZE; i++){
		currentlow = c[i].r.totalAmount;
		if(lowesto > currentlow){
			lowesto = currentlow;
			lowesti = i;
		}
	}
	
	printf("\n\nLowest Order:\n");
	printf("Customer ID: %s\n", c[lowesti].customerID);
	printf("Total Amount: %.2f",c[lowesti].r.totalAmount);

	printf("\n\nPlease ENTER to continue...");
}

