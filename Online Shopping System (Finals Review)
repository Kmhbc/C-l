void readc(struct Customer c[]){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\orders.txt", "r");
	
	char line [200];
	
	for(int i  = 0; i<SIZE; i++){
		while(fgets(line, sizeof(line), fp) != NULL){
			printf(" %s", line);
		}
	}
	fclose(fp);
}

void searchc(struct Customer c[]){
	
	system("cls");
	int found = 0;
	char searchID[20];
	
	printf("\nEnter Customer ID: ");
	scanf("%19s", searchID);
	
	printf("\nCUSTOMER FOUND!\n");
	
	for(int i  = 0; i<SIZE; i++){
		if(strcmp(searchID, c[i].customerID) == 0){
			printf("Customer Name: %s", c[i].customerName);
			printf("Product Ordered: %s", c[i].productOrdered);
			printf("Product Quantity: %s\n", c[i].r.quantity);
			printf("Total Amount: %.2f",c[i].r.totalAmount);
			
			found = 1;
			break;
		}
	}
	
	if (found == 0){
		printf("\nCUSTOMER NOT FOUND!\n");
	}
	
	getchar();
}
