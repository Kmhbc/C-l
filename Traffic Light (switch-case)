#include<stdio.h>

int main(){
	char a;
	
	printf("Enter Signal: ");
	scanf (" %c", &a);
	
	switch(a){
		case 'R':
		case 'r':
			printf ("STOP");
			break;
		case 'G':
		case 'g':
			printf("GO");
			break;
		case 'Y':
		case 'y':
			printf("SLOW DOWN");
			break;
	default:
		printf("Invalid Signal");
	}	
return 0;
		
}
