#include<stdio.h>
#include<string.h>
#include<stdlib.h>

struct Billing{
	char roomNumber[20];
	float billAmount;
};
struct Patient{
	char patientID[20];
	char patientName[80];
	char illness[80];
	struct Billing billData;
};

void displaypatData(struct Patient patData[]){
	
	printf("\n=== PATIENTS RECORD ===\n");
	for(int i = 0; i<5; i++){
		printf("\n\nPatient No. %d\n", i+1);
		printf("ID: %s\n", patData[i].patientID);
		printf("Name: %s", patData[i].patientName);
		printf("Illness: %s", patData[i].illness);
		printf("Room Number: %s", patData[i].billData.roomNumber);
		printf("\nBill Amount: %.2f", patData[i].billData.billAmount);
	}
}

void inputpatData(struct Patient patData[]){
	
	for(int i = 0; i<5; i++){
		printf("\nEnter Patient's ID (ex: 1001): ");
		scanf(" %s", &patData[i].patientID);
		getchar();
		printf("Enter Patient's Name (First Name, Last name): ");
		fgets(patData[i].patientName,sizeof(patData[i].patientName), stdin);
		printf("Enter Patient's Illness: ");
		fgets(patData[i].illness,sizeof(patData[i].illness), stdin);
		printf("Enter Patient's Room Number (ex: A64): ");
		scanf(" %s", &patData[i].billData.roomNumber);
		getchar();
		printf("Enter Patient's Bill: ");
		scanf("%f", &patData[i].billData.billAmount);
	}
}
void displayTen(struct Patient patData[]){
	
	printf("\n===== PATIENTS WITH HIGH BILLS =====\n");
	
	for(int i = 0; i<5; i++){
		if(patData[i].billData.billAmount > 10000){
			printf("\nName: %s", patData[i].patientName);
			printf("Bill Amount: %.2f", patData[i].billData.billAmount);
		}
	}
}
void searchpatData(struct Patient patData[]){
	
	char searchID[20];
	int found =0;
	
	printf("Enter Patient ID: ");
	scanf("%19s", searchID);
	
	for (int i = 0; i<5; i++){
		if(strcmp(searchID,patData[i].patientID) == 0){
			printf("\nName: %s", patData[i].patientName);
			printf("Illness: %s", patData[i].illness);
			printf("Room Number: %s", patData[i].billData.roomNumber);
			printf("\nBill Amount: %.2f", patData[i].billData.billAmount);	
			
			found = 1;
		}
	}
	if (found ==0){
		printf("\n No Patient Record\n");
	}
}

void savepatData(struct Patient patData[]){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\patients.txt","w");
	
	if(fp == NULL){
		printf("\nFile not found!\n");
	}
	
	fprintf(fp,"\n=== PATIENTS RECORD ===\n");
	for(int i = 0; i<5; i++){
		fprintf(fp,"\n\nPatient No. %d\n", i+1);
		fprintf(fp,"ID: %s\n", patData[i].patientID);
		fprintf(fp,"Name: %s", patData[i].patientName);
		fprintf(fp,"Illness: %s", patData[i].illness);
		fprintf(fp,"Room Number: %s", patData[i].billData.roomNumber);
		fprintf(fp,"\nBill Amount: %.2f", patData[i].billData.billAmount);
	}
	fclose(fp);
	
	printf("\nData Saved Successfully!\n");
}

void computeRevenue(struct Patient *ptr){
	
	FILE *fp = fopen("D:\\COMPROG\\FILES FOR FILE HANDLING\\patients.txt","a");
	
	if(fp == NULL){
		printf("\nFile not found!\n");
	};
	
	float sum = 0;
	
	for (int i = 0; i<5; i++){
		sum+= ptr[i].billData.billAmount;
	}
	
	printf("\n==== REVENUE REPORT ====\n");
	printf("Total Revenue: %.2f\n", sum);
	fprintf(fp,"\n\n==== REVENUE REPORT ====\n");
	fprintf(fp,"Total Revenue: %.2f", sum);
	
	fclose(fp);
}
int main(){
	struct Patient patData[100];
	int choice; 
	struct Patient *ptr = &patData[0];
	
	do{
		printf("\n=== HOSPITAL ===\n");
		printf("1. Enter new record\n");
		printf("2. Display All Record\n");
		printf("3. Display High Bills Patients\n");
		printf("4. Search Patient\n");
		printf("5. Revenue Report\n");
		printf("6. Exit\n");
		printf("Enter Choice: ");
		scanf("%d", &choice);
		
		switch(choice){
			
			case 1:
				inputpatData(patData);
				savepatData(patData);
			break;
			
			case 2:
				displaypatData(patData);
				computeRevenue(ptr);
			break;
			
			case 3:
				displayTen(patData);
			break;
			
			case 4:
				searchpatData(patData);
			break;
			
			case 5:
				computeRevenue(ptr);
			break;
		}
			
	}while(choice !=6);
	
return 0;
}
